# Runpod Hub worker verified on 2026-10-02:
# runpod-workers/worker-vllm v2.28.0 (vLLM 0.30.0)
# GPU: RTX 5090 32GB x1 (ADA_32_PRO), CUDA 13.0
# Short API demo settings. Long context (262144) and CUDA graphs were NOT verified on RTX 5090.

MODEL_NAME=PassingByPixels/Qwen3.8-27B-NVFP4
MODEL_REVISION=1e5f29f3212294efdef42a873672c9bc399cae3c
QUANTIZATION=modelopt
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.88
ENFORCE_EAGER=true
MAX_NUM_SEQS=8
MAX_CONCURRENCY=1
TRUST_REMOTE_CODE=true
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=qwen3_xml

# Only if you attach a Network Volume (not used in the 2026-10-02 run):
# VLLM_CACHE_ROOT=/runpod-volume/vllm_cache
# SAFETENSORS_LOAD_STRATEGY=prefetch
# SAFETENSORS_PREFETCH_NUM_THREADS=8

# Endpoint settings configured in the Runpod UI, not worker environment variables:
# Active workers (minimum): 0
# Max workers: 1
# Idle timeout: 60 seconds (2026-10-02 run)
# FlashBoot: off

# Local request clients read these values. Never commit real values.
ENDPOINT_ID=
RUNPOD_API_KEY=
