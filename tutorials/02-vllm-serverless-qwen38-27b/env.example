# Runpod Hub worker tested in the source experiment:
# runpod-workers/worker-vllm:v2.25.2
# GPU pool: ADA_32_PRO (RTX 5090), one GPU, CUDA 13.0

MODEL_NAME=PassingByPixels/Qwen3.8-27B-NVFP4
MODEL_REVISION=1e5f29f3212294efdef42a873672c9bc399cae3c
QUANTIZATION=modelopt
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.97
TRUST_REMOTE_CODE=true
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=qwen3_xml

# Optional persistent Network Volume settings used in the validated run.
VLLM_CACHE_ROOT=/runpod-volume/vllm_cache
SAFETENSORS_LOAD_STRATEGY=prefetch
SAFETENSORS_PREFETCH_NUM_THREADS=8
HF_HUB_OFFLINE=0

# Endpoint settings configured in the Runpod UI, not worker environment variables:
# minimum workers: 0
# maximum workers: 1
# idle timeout: 5 seconds
# FlashBoot: off in the validated cache experiment

# Local request clients read these values. Never commit real values.
ENDPOINT_ID=
RUNPOD_API_KEY=

